# Copy to .env, chmod 600 .env, and fill in. Never commit .env.
# The app reads real environment variables; systemd loads this file via EnvironmentFile=.
# For local runs use:  set -a; . ./.env; set +a

# --- Login (written for you by scripts.set_password, see README) ---
# bcrypt hash of your password, in single quotes. Required.
ANIMUS_PASSWORD_HASH=
# Random string of at least 32 characters used to sign session cookies. Required.
ANIMUS_SESSION_SECRET=

# --- AI features (without a key the AI pages show a notice; the journal still works) ---
# Any OpenAI-compatible provider works. Default is NVIDIA (key at https://build.nvidia.com).
# The older NVIDIA_* names still work when the LLM_* ones are unset.
LLM_API_KEY=
# OpenAI-compatible endpoint (default shown)
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  models gemini-3.6-flash,gemini-3.5-flash
# Comma-separated priority lists; the first model is tried first, the others are fallbacks.
# LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b,nvidia/nemotron-3.5-lightning-30b-a3b
# LLM_MODEL_INTERACTIVE=nvidia/nemotron-3-ultra-550b-a55b,nvidia/nemotron-3.5-lightning-30b-a3b
# LLM_MODEL_ESCALATE=nvidia/nemotron-3-ultra-550b-a55b

# --- Storage ---
# SQLite database file (default: data/vault.db next to the code)
# ANIMUS_DB_PATH=/opt/animus/data/vault.db
# Where scripts.backup writes copies (default: backups/ next to the code)
# ANIMUS_BACKUP_DIR=/opt/animus/backups

# --- Serving ---
# Extra host names the app answers to, comma separated, no scheme/port/wildcard.
# Needed when you serve it under your own domain behind HTTPS.
# ANIMUS_ALLOWED_HOSTS=journal.example.com
# Set to off to disable the background scheduler (reflections, chat memory).
# ANIMUS_SCHEDULER=on
