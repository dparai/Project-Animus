[Unit]
Description=Animus off-site copies to Google Drive
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=animus
WorkingDirectory=/opt/animus
Environment=ANIMUS_DB_PATH=/opt/animus/data/vault.db
Environment=ANIMUS_BACKUP_DIR=/opt/animus/backups
Environment=RCLONE_CONFIG=/opt/animus/rclone/rclone.conf
ExecStart=/opt/animus/.venv/bin/python -m scripts.offsite
UMask=0077
Nice=10
IOSchedulingClass=idle
MemoryMax=512M
CPUQuota=50%
TimeoutStartSec=2h
NoNewPrivileges=yes
ProtectSystem=strict
# data/ is writable so SQLite can open the live WAL database (it needs the -shm file) and the script
# can keep its small state file there; entries are only read. rclone/ holds the config, which rclone
# rewrites when it refreshes the Drive token. backups/ is read-only here.
ReadWritePaths=/opt/animus/rclone /opt/animus/data
ReadOnlyPaths=/opt/animus/backups
PrivateTmp=yes
ProtectHome=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
